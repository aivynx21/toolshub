{
  "name": "Toolhub — Fast, focused tools",
  "short_name": "Toolhub",
  "description": "A curated directory of fast, focused web tools.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
